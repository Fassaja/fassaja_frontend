# URL pública da API (inclua o /api ao final).
# Local:      http://localhost:3333/api
# Produção:   https://api.seusite.com/api
VITE_API_URL=http://localhost:3333/api

# App na Google Play. Deixe VAZIO até o app estar publicado: com o pacote
# vazio, o site não fala do Pro como comprável e o app não tenta o Play
# Billing. Precisa ser o mesmo nome do Play Console e do Bubblewrap.
VITE_ANDROID_PACKAGE=
# Id do produto de assinatura (Play Console > Monetizar > Assinaturas).
VITE_PLAY_SKU=pro_mensal
